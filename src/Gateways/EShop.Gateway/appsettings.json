{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "redis": "localhost:6379"
  },
  "Caching": {
    "KeyPrefix": "eshop",
    "InvalidationChannel": "eshop:cache-invalidation"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-public": {
        "ClusterId": "catalog",
        "OutputCachePolicy": "PublicApi",
        "Match": {
          "Path": "/api/catalog/{**rest}",
          "Methods": [ "GET", "HEAD" ]
        }
      },
      "catalog-writes": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**rest}"
        }
      },
      "basket": {
        "ClusterId": "basket",
        "Match": {
          "Path": "/api/basket/{**rest}"
        }
      },
      "sessions": {
        "ClusterId": "basket",
        "Match": {
          "Path": "/api/session{**rest}"
        }
      }
    },
    "Clusters": {
      "catalog": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "catalog-1": { "Address": "http://localhost:5101/" }
        }
      },
      "basket": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "basket-1": { "Address": "http://localhost:5102/" }
        }
      }
    }
  }
}
